# Copy this file to .env.local and fill in your values.

# Required for real scoring. Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: change the model. Cheaper option: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional but STRONGLY recommended before you deploy publicly.
# When set, users must enter this code once to use the app. This protects
# your API credits from strangers. Leave it blank/unset for local testing.
APP_PASSWORD=12345
